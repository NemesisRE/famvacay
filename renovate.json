{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    "security:openssf-scorecard"
  ],
  "timezone": "UTC",
  "schedule": ["before 5am on Monday"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "pinDigests": true,
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "ignoreDeps": ["famvacay"],
  "labels": ["dependencies", "automated"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security", "vulnerability"],
    "addLabels": ["security", "high-priority"]
  },
  "packageRules": [
    {
      "description": "Group minor and patch dependencies to minimize pull request noise",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "production minor and patch updates",
      "groupSlug": "prod-minor-patch"
    },
    {
      "description": "Group linters, type checkers, and test frameworks together",
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "eslint",
        "eslint-*",
        "@typescript-eslint/*",
        "prettier",
        "prettier-*",
        "vitest",
        "@vitest/*",
        "@playwright/*",
        "typescript",
        "postcss",
        "tailwindcss",
        "@tailwindcss/*"
      ],
      "groupName": "development & quality toolchain",
      "groupSlug": "dev-toolchain"
    },
    {
      "description": "Playwright's npm package and the CI container image (browsers) must always have the same version: one PR for both",
      "matchPackageNames": ["@playwright/*", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "groupSlug": "playwright"
    },
    {
      "description": "Isolated review for major updates",
      "matchUpdateTypes": ["major"],
      "schedule": ["before 5am on Monday"],
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "TypeScript is pinned to v6 until TS 7 ecosystem support matures: see docs/dependencies.md#known-blocked-major-upgrades.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "PostgreSQL major version upgrades require manual data migration (pg_dumpall / pg_upgrade) and must not be proposed as routine automated container updates.",
      "matchPackageNames": ["postgres", "library/postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Pin GitHub Actions to immutable full commit SHAs with comments",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}

