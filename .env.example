# ==========================================
# FamVacay Environment Configuration
# ==========================================

# Public Facing URL (behind reverse proxy)
# Used for canonical URL generation and CSRF protection in Server Actions
APP_URL=https://vacations.example.com

# Comma-separated list of additional allowed hosts for Server Actions
ALLOWED_ORIGINS=vacations.example.com,localhost:3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=famvacay
POSTGRES_PASSWORD=famvacay_secure_password_replace_me
POSTGRES_DB=famvacay_db
DATABASE_URL=postgresql://famvacay:famvacay_secure_password_replace_me@postgres:5432/famvacay_db?schema=public

# Redis Configuration (Caching & Rate Limiting)
REDIS_URL=redis://redis:6379

# External APIs (Optional - Fallbacks to local climate & benchmark databases if absent)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

