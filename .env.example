# ==============================================================================
# FamVacay Environment Configuration (.env.example)
# ==============================================================================

# Application Environment ('development', 'production', 'test')
NODE_ENV=production

# Server Port
PORT=3000

# Canonical Public URL (Required in production)
# All absolute URLs, redirects, passkey RP IDs, and OAuth callbacks derive strictly from this.
APP_URL=https://famvacay.us

# Reverse Proxy Security Configuration
# Set to 'true' when operating behind TLS-terminating reverse proxy (Traefik, Nginx, Caddy, etc.)
TRUST_PROXY=true

# Number of trusted reverse proxy hops between client and application (Default: 1)
# Used to extract client IP from the right-most untrusted entry for rate limiting.
TRUSTED_PROXY_HOPS=1

# Comma-separated list of additional allowed hosts for Server Actions
ALLOWED_ORIGINS=famvacay.us,localhost:3000

# NextAuth / Session Secret (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=changeme-production-secret-min32chars
NEXTAUTH_URL=https://famvacay.us

# Database Connection (PostgreSQL 15 or 16)
POSTGRES_USER=famvacay
POSTGRES_PASSWORD=famvacay_secure_password
POSTGRES_DB=famvacay_db
# For local dev host: localhost:5432. For container network: postgres:5432
DATABASE_URL=postgresql://famvacay:famvacay_secure_password@localhost:5432/famvacay_db?schema=public

# In-Memory Cache & Rate Limiting (Valkey / Redis compatible)
REDIS_URL=redis://cache:6379

# Geocoding & Autocomplete Provider Endpoint
# Default public Komoot Photon, or point to self-hosted Photon container
PHOTON_API_URL=https://photon.komoot.io/api

# Holiday Data Providers
OPEN_HOLIDAYS_API_URL=https://openholidaysapi.org
NAGER_DATE_API_URL=https://date.nager.at/api/v3

# Climate Data Provider
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Optional OAuth Social Login Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional: Host port binding for web service (leave empty if using proxy network)
# WEB_PORT=3000
