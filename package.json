{
  "name": "famvacay",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "homepage": "https://famvacay.us",
  "repository": {
    "type": "git",
    "url": "https://github.com/NemesisRE/famvacay.git"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:up": "docker compose up -d postgres cache && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "generate:city-names": "node scripts/generate-city-names.js",
    "generate:flight-routes": "node scripts/generate-flight-routes.js",
    "generate:airport-traffic": "node scripts/generate-airport-traffic.js",
    "generate:climate-normals": "node scripts/generate-climate-normals.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@floating-ui/react": "^0.27.20",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-holidays": "^3.37.0",
    "geolib": "^4.0.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.4.1",
    "iso-3166-2": "^1.0.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/iso-3166-2": "^1.0.4",
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "airport-data": "^1.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
