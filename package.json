{
  "name": "famvacay",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "homepage": "https://famvacay.us",
  "repository": {
    "type": "git",
    "url": "https://github.com/NemesisRE/famvacay.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:up": "docker compose up -d postgres cache && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "generate:airports-db": "tsx scripts/generate-airports-db.ts",
    "generate:city-names": "tsx scripts/generate-city-names.ts",
    "generate:flight-routes": "tsx scripts/generate-flight-routes.ts",
    "generate:airport-traffic": "tsx scripts/generate-airport-traffic.ts",
    "generate:climate-normals": "tsx scripts/generate-climate-normals.ts",
    "generate:holiday-appeal": "tsx scripts/generate-holiday-appeal.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@floating-ui/react": "^0.27.20",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "airport-data": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-holidays": "^3.38.0",
    "geolib": "^4.0.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^6.0.0",
    "iso-3166-2": "^1.0.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/iso-3166-2": "^1.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.30",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
