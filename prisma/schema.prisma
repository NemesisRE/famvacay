datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

// -------------------------------------------------------------
// Authentication Models (NextAuth + WebAuthn/Passkey support)
// -------------------------------------------------------------

model User {
  id            String             @id @default(uuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  passkeys      Authenticator[]
  familyProfile FamilyProfile?     // Optional primary link for backwards-compatibility
  memberships   FamilyMembership[] // Flat shared family memberships
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @id
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
  @@index([userId])
}

// -------------------------------------------------------------
// Flat Shared Family Profile & Travel Preferences
// -------------------------------------------------------------

model FamilyProfile {
  id                    String             @id @default(uuid())
  userId                String?            @unique // Optional primary link for backwards-compatibility
  user                  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyName            String?
  homeLocation          String             // Human-readable place name ("City, Region, Country")
  homeLat               Float?
  homeLon               Float?
  homePlaceId           String?
  federalState          String             // Holiday subdivision code (e.g., "DE-BW", "FR-IDF")
  holidayCountry        String?            @default("DE")
  holidaySubdivision    String?
  workweekDays          Int[]              @default([1, 2, 3, 4, 5]) // Mon(1) - Fri(5)
  originAirports        String[]           @default([])
  maxDrivingHours       Float?             @default(2.5)
  maxTravelHours        Float?
  directFlightsOnly     Boolean            @default(false)
  preferredCabinClass   String?            @default("ECONOMY")
  climatePreference     String?            @default("MODERATE")
  passportCheckRequired Boolean            @default(false)
  travelModes           String[]           @default(["FLIGHT", "CAR"])
  scoringWeights        Json?
  preferredPortals      String[]           @default([])
  locale                String             @default("en")
  currency              String             @default("EUR")
  membersCount          Int                @default(1)
  
  // Relations
  memberships           FamilyMembership[]
  invites               FamilyInvite[]
  members               FamilyMember[]
  blackoutRanges        BlackoutDate[]     // Legacy table relation
  blackoutPeriods       BlackoutPeriod[]   // Master prompt specification
  preferredAirports     FamilyAirport[]
  tripSearches          TripSearch[]
  trips                 TripPlan[]         // Legacy table relation

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model FamilyMembership {
  id              String        @id @default(uuid())
  userId          String
  familyProfileId String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([userId, familyProfileId])
  @@index([userId])
  @@index([familyProfileId])
}

model FamilyInvite {
  id              String        @id @default(uuid())
  familyProfileId String
  tokenHash       String        @unique
  expiresAt       DateTime
  used            Boolean       @default(false)
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([familyProfileId])
}

model FamilyMember {
  id              String        @id @default(uuid())
  familyProfileId String
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  displayName     String?
  firstName       String?       // Legacy alias
  role            String        @default("MEMBER")
  birthDate       DateTime      @db.Date
  schoolRequired  Boolean       @default(false)
  schoolSubdivision String?     // ISO 3166-2 region whose school calendar this child follows (null = home region)
  passportExpiry  DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([familyProfileId])
}

model Place {
  id              String       @id @default(uuid())
  provider        String       // e.g. "photon", "nominatim"
  providerId      String?
  displayName     String
  category        String       // "CITY", "ISLAND", "REGION", "COUNTRY", "OTHER"
  lat             Float
  lon             Float
  countryCode     String?
  subdivisionCode String?
  tripSearches    TripSearch[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([countryCode])
  @@index([category])
}

model Airport {
  iata                   String          @id // 3-letter IATA code, e.g. "FRA", "CDG"
  icao                   String?
  name                   String
  municipality           String?
  country                String
  subdivision            String?
  lat                    Float
  lon                    Float
  type                   String          // "large_airport", "medium_airport"
  scheduledService       Boolean         @default(true)
  highSpeedRailConnected Boolean?
  sourceUpdatedAt        DateTime        @default(now())
  familyAirports         FamilyAirport[]

  @@index([country])
}

model FamilyAirport {
  id              String        @id @default(uuid())
  familyProfileId String
  airportIata     String
  drivingMinutes  Int?          // Cached OSRM road routing duration (home -> airport)
  drivingKm       Float?        // Cached OSRM road routing distance (home -> airport)
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  airport         Airport       @relation(fields: [airportIata], references: [iata], onDelete: Cascade)

  @@unique([familyProfileId, airportIata])
  @@index([familyProfileId])
  @@index([airportIata])
}

// STRICT_BLACKOUT: travel impossible (work lockouts, weddings) - hard candidate filter.
// CHILDCARE_CLOSURE: daycare/Kita closed - travel is possible and consumes 0 *marginal* PTO
// during overlapping weekdays (scaled by coverageFactor), since PTO is already bound by childcare duties.
enum PeriodType {
  STRICT_BLACKOUT
  CHILDCARE_CLOSURE
}

model BlackoutPeriod {
  id              String        @id @default(uuid())
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  recurrence      String        @default("NONE") // "NONE" | "YEARLY"
  reason          String?
  type            PeriodType    @default(STRICT_BLACKOUT)
  coverageFactor  Float         @default(1.0) // % of closure days parents must cover with own PTO (1.0 = 100%, 0.5 = grandparents cover half)
  familyProfileId String
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)

  @@index([familyProfileId])
}

model TripSearch {
  id               String        @id @default(uuid())
  familyProfileId  String
  durationMin      Int
  durationMax      Int
  earliestDate     DateTime      @db.Date
  latestDate       DateTime      @db.Date
  maxBudget        Decimal?      @db.Decimal(10, 2)
  currency         String        @default("EUR")
  selectedAirports String[]
  destinations     Place[]
  familyProfile    FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([familyProfileId])
}

// -------------------------------------------------------------
// Persistent Trip Sharing, Voting & Stateless .ics Export
// -------------------------------------------------------------

model SharedTripBoard {
  id              String            @id @default(uuid())
  shortCode       String            @unique
  familyProfileId String?
  searchParams    Json
  candidates      SharedCandidate[]
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())

  @@index([familyProfileId])
}

model SharedCandidate {
  id              String          @id @default(uuid())
  boardId         String
  board           SharedTripBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  destinationCode String
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  snapshotData    Json
  votes           CandidateVote[]

  @@index([boardId])
}

model CandidateVote {
  id          String          @id @default(uuid())
  candidateId String
  candidate   SharedCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterName   String
  vote        Int             // -1 = Veto, 1 = Upvote, 2 = Favorite
  comment     String?
  createdAt   DateTime        @default(now())

  @@unique([candidateId, voterName])
  @@index([candidateId])
}

/// Reference datasets (airports, routes, traffic, city names, climate normals) refreshed in the
/// background by the app itself (src/lib/datasets/refresh-service.ts). The JSON bundled in the
/// repo is only the seed until the first refresh is published here.
model GeneratedDataset {
  name           String    @id
  /// Increments with every published payload; replicas load anything newer than what they hold
  version        Int       @default(0)
  /// gzip-compressed JSON of the published dataset
  payload        Bytes?
  payloadSha256  String?
  publishedAt    DateTime?
  /// gzip-compressed JSON of the generator's resumable progress (e.g. climate cells fetched)
  generatorState Bytes?
  lastAttemptAt  DateTime?
  lastError      String?
  /// When the next refresh should run (null = as soon as possible, e.g. on a fresh install)
  nextDueAt      DateTime?
  /// Lease so only one replica refreshes a dataset at a time
  leaseOwner     String?
  leaseUntil     DateTime?
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------------------------------
// Legacy Models Preserved for Database Migration Compatibility
// -------------------------------------------------------------

model BlackoutDate {
  id              String        @id @default(uuid())
  startDate       DateTime
  endDate         DateTime
  reason          String?
  familyProfileId String
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
}

model TripPlan {
  id              String        @id @default(uuid())
  destinationType String
  targetRegion    String?
  durationDays    Int
  earliestDate    DateTime
  latestDate      DateTime
  maxBudgetTotal  Float?
  familyProfileId String
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
